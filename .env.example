# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=

# Юзернейм бота без @ (нужен только для кнопки на веб-странице)
BOT_USERNAME=
# Если пусто, имя определится при старте бота и сохранится в этот файл.
# BOT_USERNAME_FILE=bot_username.txt

# Канал, подписка на который обязательна
CHANNEL=@LiVPN_official
CHANNEL_HANDLE=@LiVPN_official
CHANNEL_URL=https://t.me/LiVPN_official
# Если канал приватный — числовой id вида -1001234567890
CHANNEL_ID=

# Ваш Telegram ID для /stats, /clearcache (узнать: /myid)
ADMIN_IDS=

SUPPORT_URL=https://t.me/livpn_official

# ── Публичный адрес ───────────────────────────────────────────────────────────
# Домен/адрес сервиса. Приоритетнее автоопределения.
# Если пусто — домен запомнится из запроса, иначе определится внешний IP.
PUBLIC_BASE_URL=
# Автоматически запоминать домен из первого запроса к Flask
AUTO_DOMAIN=1
# Проверять, что домен из Host действительно указывает на этот сервер
# (защита от подмены ссылок через поддельный заголовок Host). Проверка:
# DNS → публичный IP, либо запрос к https://домен/healthz с маркером
# процесса. Отключите, если проверка мешает (например, свой прокси
# скрывает /healthz и /), — тогда лучше задать PUBLIC_BASE_URL.
AUTO_DOMAIN_VERIFY=1
BASE_URL_FILE=base_url.txt
# Белый список доменов (защита от подмены Host), необязательно
ALLOWED_HOSTS=

HOST=0.0.0.0
PORT=8080
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=240

# Прокси для Telegram/Groq (Россия). Один на оба сервиса:
PROXY_URL=
# Или отдельно:
TELEGRAM_PROXY=
GROQ_PROXY=
# Локальный Bot API server (необязательно):
# TELEGRAM_API_URL=http://127.0.0.1:8081/bot{0}/{1}

# ── Подписка ──────────────────────────────────────────────────────────────────
SUB_NAME=LiVPN 🌐
SUB_SUFFIX= | LiVPN
SUB_DESCRIPTION=Наш телеграм канал: https://t.me/livpn_official\nОбновляйте подписку каждые 24 часа.\nДаты истекания нету.
UPDATE_INTERVAL_HOURS=24
TOKEN_LEN=24
MAX_NODES=500
USER_REFRESH_COOLDOWN_MINUTES=10

# ── Groq / переименование узлов ───────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_ENABLED=1
AI_BATCH_SIZE=40
AI_MAX_TOKENS=2048
GROQ_TIMEOUT=45

# ── Источник узлов ────────────────────────────────────────────────────────────
# static | xui | upstream | remnawave | vlesshub
PROVIDER=static
NODES_FILE=nodes.json

# Для PROVIDER=upstream: ссылка на ВАШУ официальную подписку.
# Можно задать персонально в subs.upstream_url.
UPSTREAM_URL=
UPSTREAM_USER_AGENT=Happ/3.0 (Android)
HTTP_TIMEOUT=30

# Для PROVIDER=xui: своя панель 3x-ui
XUI_BASE_URL=
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=1
XUI_INBOUND_REMARK=
XUI_SERVER_ADDRESS=
XUI_VERIFY_TLS=1
XUI_TOTAL_GB=0
XUI_FLOW=

# ── Прочее ────────────────────────────────────────────────────────────────────
DB_PATH=livpn.db
LOG_LEVEL=INFO
REFRESH_CHECK_SECONDS=900
REFRESH_WORKERS=3
WEB_TITLE=LiVPN
